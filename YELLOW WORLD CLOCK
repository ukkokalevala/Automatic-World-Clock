/*
  Automatic World Clock - Flips through world capitals every 10 seconds
  Wiring: SCL -> GPIO7, SDA -> GPIO6
*/

#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <WiFi.h>
#include <time.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDR 0x3C

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ========== WiFi Configuration ==========
const char* WIFI_SSID = "YOUR_SSID";      // CHANGE THIS
const char* WIFI_PASSWORD = "YOUR_PASSWORD";   // CHANGE THIS

// ========== World Capitals ==========
struct Capital {
  const char* name;
  const char* country;
  long offset;  // GMT offset in seconds
};

const Capital CAPITALS[] = {
  {"Cape Town", "S. Africa", 7200},       // GMT+2
  {"London", "UK", 0},                    // GMT+0
  {"Paris", "France", 3600},              // GMT+1
  {"Berlin", "Germany", 3600},            // GMT+1
  {"Moscow", "Russia", 10800},            // GMT+3
  {"Dubai", "UAE", 14400},                // GMT+4
  {"Mumbai", "India", 19800},             // GMT+5:30
  {"Beijing", "China", 28800},            // GMT+8
  {"Tokyo", "Japan", 32400},              // GMT+9
  {"Sydney", "Australia", 39600},         // GMT+11
  {"New York", "USA", -18000},            // GMT-5
  {"Los Angeles", "USA", -28800},         // GMT-8
  {"Rio", "Brazil", -10800}               // GMT-3
};

const int NUM_CAPITALS = sizeof(CAPITALS) / sizeof(CAPITALS[0]);
int currentIndex = 0;
unsigned long lastFlipTime = 0;
const unsigned long FLIP_INTERVAL = 10000;  // 10 seconds

// Month names
const char* MONTH_NAMES[] = {"Jan", "Feb", "Mar", "Apr", "May", "Jun", 
                             "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"};

// Day names
const char* DAY_NAMES[] = {"Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"};

// ========== Function Prototypes ==========
void connectWiFi();
void syncTime(long offset);
String getFormattedTime();
String getFormattedDate();
String getDayName();
void displayClock();
void drawCentered(const String &text, int y, int textSize);

// ========== Setup ==========
void setup() {
  Serial.begin(115200);
  delay(1000);
  
  // Initialize I2C with SCL=7, SDA=6 (YOUR WORKING ORDER)
  Wire.begin(7, 6);
  
  // Initialize OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println("OLED not found!");
    while (1) delay(1000);
  }
  
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  
  // Show startup message
  display.setTextSize(1);
  display.setCursor(20, 28);
  display.println("Starting...");
  display.display();
  delay(1000);
  
  // Connect to WiFi
  display.clearDisplay();
  display.setCursor(15, 28);
  display.println("Connecting WiFi");
  display.display();
  
  connectWiFi();
  
  // Initial time sync
  syncTime(CAPITALS[0].offset);
  
  lastFlipTime = millis();
}

// ========== Main Loop ==========
void loop() {
  // Flip to next capital every 10 seconds
  if (millis() - lastFlipTime >= FLIP_INTERVAL) {
    lastFlipTime = millis();
    currentIndex = (currentIndex + 1) % NUM_CAPITALS;
    
    // Sync time for new capital
    syncTime(CAPITALS[currentIndex].offset);
    
    // Show capital name briefly
    display.clearDisplay();
    drawCentered(String(CAPITALS[currentIndex].name), 28, 1);
    display.display();
    delay(800);
  }
  
  // Display current time
  displayClock();
  delay(100);
}

// ========== Connect to WiFi ==========
void connectWiFi() {
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWiFi connected!");
  } else {
    Serial.println("\nWiFi failed!");
  }
}

// ========== Sync Time with NTP ==========
void syncTime(long offset) {
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }
  
  Serial.print("Syncing time for ");
  Serial.print(CAPITALS[currentIndex].name);
  Serial.print(" (GMT");
  Serial.print(offset / 3600);
  Serial.println(")");
  
  configTime(offset, 0, "pool.ntp.org");
  
  struct tm timeinfo;
  int attempts = 0;
  while (!getLocalTime(&timeinfo) && attempts < 10) {
    delay(500);
    attempts++;
  }
}

// ========== Get Formatted Time ==========
String getFormattedTime() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return "--:--:--";
  }
  
  char buffer[9];
  strftime(buffer, sizeof(buffer), "%H:%M:%S", &timeinfo);
  return String(buffer);
}

// ========== Get Formatted Date ==========
String getFormattedDate() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return "--- -- ----";
  }
  
  char buffer[16];
  sprintf(buffer, "%02d %s %04d", timeinfo.tm_mday, 
          MONTH_NAMES[timeinfo.tm_mon], timeinfo.tm_year + 1900);
  return String(buffer);
}

// ========== Get Day Name ==========
String getDayName() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    return "---";
  }
  
  // tm_wday: 0=Sunday, adjust to Monday=0
  int wday = (timeinfo.tm_wday + 6) % 7;
  return String(DAY_NAMES[wday]);
}

// ========== Helper: Draw Centered Text ==========
// Measures the real pixel width of the text and centers it,
// clamping to x=0 so the first character is never clipped.
void drawCentered(const String &text, int y, int textSize) {
  display.setTextSize(textSize);
  
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
  
  int x = (SCREEN_WIDTH - w) / 2;
  if (x < 0) x = 0;
  
  display.setCursor(x, y);
  display.print(text);
}

// ========== Display Clock ==========
void displayClock() {
  String timeStr = getFormattedTime();
  String dateStr = getFormattedDate();
  String dayStr  = getDayName();
  
  display.clearDisplay();
  
  // Draw separator line (yellow/blue boundary)
  display.drawLine(0, 15, 127, 15, SSD1306_WHITE);
  
  // ===== YELLOW AREA (Top) - City and Country =====
  // Build location string; if too wide, fall back to city only
  String location = String(CAPITALS[currentIndex].name) + ", " + String(CAPITALS[currentIndex].country);
  
  display.setTextSize(1);
  int16_t x1, y1;
  uint16_t w, h;
  display.getTextBounds(location, 0, 0, &x1, &y1, &w, &h);
  
  if (w > SCREEN_WIDTH) {
    location = String(CAPITALS[currentIndex].name);
  }
  
  drawCentered(location, 4, 1);
  
  // ===== BLUE AREA (Bottom) - Time & Date =====
  // Large time
  drawCentered(timeStr, 22, 2);
  
  // Separator line under time
  display.drawLine(20, 40, 107, 40, SSD1306_WHITE);
  
  // Date
  drawCentered(dateStr, 46, 1);
  
  // Day
  drawCentered(dayStr, 56, 1);
  
  display.display();
}
